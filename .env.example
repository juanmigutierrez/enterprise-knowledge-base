# Copy to .env (git-ignored). No real secrets are needed for the local profile.

# Which config profile to use: local (default) | ci | bedrock
EKB_PROFILE=local

# Infrastructure endpoints (S17). The defaults are the ports compose.yaml publishes on
# 127.0.0.1, for commands run on the host (`make up`, then `--docker`); compose.yaml
# sets the in-network addresses (kafka:9092 …) for its own services. Set them only
# if your infrastructure is elsewhere.
# EKB_KAFKA_BOOTSTRAP=127.0.0.1:29092
# EKB_DYNAMODB_URL=http://localhost:8000
# EKB_S3_URL=http://localhost:8333
# EKB_OPENSEARCH_URL=http://localhost:9200
OLLAMA_URL=http://localhost:11434

# Bedrock profile only. Prefer `aws sso login` + AWS_PROFILE over static keys.
AWS_REGION=eu-central-1
# AWS_PROFILE=ekb-dev

# Spend guard for experiments (USD); the runner stops when the logged cost exceeds it.
EKB_MAX_SPEND_USD=25

# Model gateway (S7): free API tiers, tried in order for each task (config/default.yaml).
# A key left empty removes that provider from every task's chain. How to get each key:
# docs/walkthrough/S07-model-gateway.md, "Get the free API keys". Run with the keys:
#   uv run --env-file .env ekb demo gateway
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# Never set LANGSMITH_TRACING: LangChain would send every prompt to LangSmith.
