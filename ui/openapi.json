            "type": "array"
          },
          "group": {
            "title": "Group",
            "type": "string"
          },
          "lag": {
            "title": "Lag",
            "type": "integer"
          }
        },
        "required": [
          "group",
          "committed",
          "lag"
        ],
        "title": "GroupView",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "OriginalView": {
        "description": "One stored version of an item's original: where it is and how big, not its bytes.",
        "properties": {
          "checksum": {
            "title": "Checksum",
            "type": "string"
          },
          "pointer": {
            "title": "Pointer",
            "type": "string"
          },
          "size": {
            "title": "Size",
            "type": "integer"
          },
          "stored_at": {
            "format": "date-time",
            "title": "Stored At",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "pointer",
          "version",
          "size",
          "checksum",
          "stored_at"
        ],
        "title": "OriginalView",
        "type": "object"
      },
      "RecordView": {
        "description": "One registry record: what the knowledge base last processed for an item.",
        "properties": {
          "acl": {
            "$ref": "#/components/schemas/AclView"
          },
          "changed_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Changed By"
          },
          "content_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
