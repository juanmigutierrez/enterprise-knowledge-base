{
  "components": {
    "schemas": {
      "AclView": {
        "properties": {
          "groups": {
            "items": {
              "type": "string"
            },
            "title": "Groups",
            "type": "array"
          },
          "users": {
            "items": {
              "type": "string"
            },
            "title": "Users",
            "type": "array"
          }
        },
        "required": [
          "users",
          "groups"
        ],
        "title": "AclView",
        "type": "object"
      },
      "ChangeLogView": {
        "description": "The event bus: how many events each partition holds, and how far each group has read.",
        "properties": {
          "end_offsets": {
            "items": {
              "type": "integer"
            },
            "title": "End Offsets",
            "type": "array"
          },
          "events": {
            "title": "Events",
            "type": "integer"
          },
          "groups": {
            "items": {
              "$ref": "#/components/schemas/GroupView"
            },
            "title": "Groups",
            "type": "array"
          },
          "partitions": {
            "title": "Partitions",
            "type": "integer"
          }
        },
        "required": [
          "partitions",
          "end_offsets",
          "events",
          "groups"
        ],
        "title": "ChangeLogView",
        "type": "object"
      },
      "ChangeOp": {
        "description": "What happened to the document in the source system.",
        "enum": [
          "upsert",
          "delete",
          "acl_change"
        ],
        "title": "ChangeOp",
        "type": "string"
      },
      "DecisionPage": {
        "description": "Decisions after a cursor (filtered), the next cursor, and the totals (unfiltered).",
        "properties": {
          "counts": {
            "$ref": "#/components/schemas/DiffCounts"
          },
          "cursor": {
            "title": "Cursor",
            "type": "integer"
          },
          "decisions": {
            "items": {
              "$ref": "#/components/schemas/DecisionView"
            },
            "title": "Decisions",
            "type": "array"
          }
        },
        "required": [
          "decisions",
          "cursor",
          "counts"
        ],
        "title": "DecisionPage",
        "type": "object"
      },
      "DecisionView": {
        "description": "One T2 decision: the event, what it needs, and why (S4).",
        "properties": {
          "acl": {
            "$ref": "#/components/schemas/AclView"
          },
          "action": {
            "$ref": "#/components/schemas/DiffAction"
          },
          "changed_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Changed By"
          },
          "decided_at": {
            "format": "date-time",
            "title": "Decided At",
            "type": "string"
          },
          "document_key": {
            "title": "Document Key",
            "type": "string"
          },
          "op": {
            "$ref": "#/components/schemas/ChangeOp"
          },
          "previous_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Version"
          },
          "purged": {
            "title": "Purged",
            "type": "integer"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "seq": {
            "title": "Seq",
            "type": "integer"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "seq",
          "decided_at",
          "document_key",
          "source",
          "source_id",
          "op",
          "version",
          "previous_version",
          "action",
          "reason",
          "acl",
          "changed_by",
          "purged"
        ],
        "title": "DecisionView",
        "type": "object"
      },
      "DiffAction": {
        "description": "What the steps after T2 must do with one event.",
        "enum": [
          "process",
          "acl_only",
          "skip",
          "purge"
        ],
        "title": "DiffAction",
        "type": "string"
      },
      "DiffCounts": {
        "description": "How many decisions of each kind T2 has made since the inspector started.",
        "properties": {
          "acl_only": {
            "title": "Acl Only",
            "type": "integer"
          },
          "process": {
            "title": "Process",
            "type": "integer"
          },
          "purge": {
            "title": "Purge",
            "type": "integer"
          },
          "skip": {
            "title": "Skip",
            "type": "integer"
          }
        },
        "required": [
          "process",
          "acl_only",
          "skip",
          "purge"
        ],
        "title": "DiffCounts",
        "type": "object"
      },
      "DocumentView": {
        "description": "An item's current state: its latest event, and how many it has had.",
        "properties": {
          "deleted": {
            "title": "Deleted",
            "type": "boolean"
          },
          "document_key": {
            "title": "Document Key",
            "type": "string"
          },
          "events": {
            "title": "Events",
            "type": "integer"
          },
          "last": {
            "$ref": "#/components/schemas/EventView"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          }
        },
        "required": [
          "document_key",
          "source",
          "source_id",
          "deleted",
          "last",
          "events"
        ],
        "title": "DocumentView",
        "type": "object"
      },
      "EventPage": {
        "description": "Events after a cursor, and the cursor to pass next time (for live polling).",
        "properties": {
          "cursor": {
            "title": "Cursor",
            "type": "integer"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/EventView"
            },
            "title": "Events",
            "type": "array"
          }
        },
        "required": [
          "events",
          "cursor"
        ],
        "title": "EventPage",
        "type": "object"
      },
      "EventView": {
        "description": "One event as received, with the log's arrival number and its place in the bus.",
        "properties": {
          "acl": {
            "$ref": "#/components/schemas/AclView"
          },
          "changed_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Changed By"
          },
          "content_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Hash"
          },
          "document_key": {
            "title": "Document Key",
            "type": "string"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          },
          "op": {
            "$ref": "#/components/schemas/ChangeOp"
          },
          "partition": {
            "title": "Partition",
            "type": "integer"
          },
          "person_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Person Id"
          },
          "raw_pointer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw Pointer"
          },
          "received_at": {
            "format": "date-time",
            "title": "Received At",
            "type": "string"
          },
          "schema_version": {
            "title": "Schema Version",
            "type": "integer"
          },
          "seq": {
            "title": "Seq",
            "type": "integer"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "seq",
          "received_at",
          "partition",
          "offset",
          "document_key",
          "source",
          "source_id",
          "op",
          "version",
          "occurred_at",
          "acl",
          "person_id",
          "changed_by",
          "raw_pointer",
          "content_hash",
          "schema_version"
        ],
        "title": "EventView",
        "type": "object"
      },
      "GroupView": {
        "description": "A consumer group: per partition, the offset of its next pending event.",
        "properties": {
          "committed": {
            "items": {
              "type": "integer"
            },
