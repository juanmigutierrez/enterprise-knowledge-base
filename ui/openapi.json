            "title": "Content Hash"
          },
          "deleted": {
            "title": "Deleted",
            "type": "boolean"
          },
          "document_key": {
            "title": "Document Key",
            "type": "string"
          },
          "events": {
            "title": "Events",
            "type": "integer"
          },
          "originals": {
            "title": "Originals",
            "type": "integer"
          },
          "person_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Person Id"
          },
          "raw_pointer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw Pointer"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "document_key",
          "source",
          "source_id",
          "version",
          "deleted",
          "content_hash",
          "acl",
          "raw_pointer",
          "person_id",
          "changed_by",
          "updated_at",
          "events",
          "originals"
        ],
        "title": "RecordView",
        "type": "object"
      },
      "SourceView": {
        "properties": {
          "deleted": {
            "title": "Deleted",
            "type": "integer"
          },
          "events": {
            "title": "Events",
            "type": "integer"
          },
          "items": {
            "title": "Items",
            "type": "integer"
          },
          "last_event_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
