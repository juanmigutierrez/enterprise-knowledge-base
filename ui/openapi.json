{
  "components": {
    "schemas": {
      "AclView": {
        "properties": {
          "groups": {
            "items": {
              "type": "string"
            },
            "title": "Groups",
            "type": "array"
          },
          "users": {
            "items": {
              "type": "string"
            },
            "title": "Users",
            "type": "array"
          }
        },
        "required": [
          "users",
          "groups"
        ],
        "title": "AclView",
        "type": "object"
      },
      "ChangeOp": {
        "description": "What happened to the document in the source system.",
        "enum": [
          "upsert",
          "delete",
          "acl_change"
        ],
        "title": "ChangeOp",
        "type": "string"
      },
      "DocumentView": {
        "description": "An item's current state: its latest event, and how many it has had.",
        "properties": {
          "deleted": {
            "title": "Deleted",
            "type": "boolean"
          },
          "document_key": {
            "title": "Document Key",
            "type": "string"
          },
          "events": {
            "title": "Events",
            "type": "integer"
          },
          "last": {
            "$ref": "#/components/schemas/EventView"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          }
        },
        "required": [
          "document_key",
          "source",
          "source_id",
          "deleted",
          "last",
          "events"
        ],
        "title": "DocumentView",
        "type": "object"
      },
      "EventPage": {
        "description": "Events after a cursor, and the cursor to pass next time (for live polling).",
        "properties": {
          "cursor": {
            "title": "Cursor",
            "type": "integer"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/EventView"
            },
            "title": "Events",
            "type": "array"
          }
        },
        "required": [
          "events",
          "cursor"
        ],
        "title": "EventPage",
        "type": "object"
      },
      "EventView": {
        "description": "One event as received, with the log's arrival number.",
        "properties": {
          "acl": {
            "$ref": "#/components/schemas/AclView"
          },
          "changed_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Changed By"
          },
          "content_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Hash"
          },
          "document_key": {
            "title": "Document Key",
            "type": "string"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "op": {
            "$ref": "#/components/schemas/ChangeOp"
          },
          "person_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Person Id"
          },
          "raw_pointer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw Pointer"
          },
          "received_at": {
            "format": "date-time",
            "title": "Received At",
            "type": "string"
          },
          "schema_version": {
            "title": "Schema Version",
            "type": "integer"
          },
          "seq": {
            "title": "Seq",
            "type": "integer"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "seq",
          "received_at",
          "document_key",
          "source",
          "source_id",
          "op",
          "version",
          "occurred_at",
          "acl",
          "person_id",
          "changed_by",
          "raw_pointer",
          "content_hash",
          "schema_version"
        ],
        "title": "EventView",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "SourceView": {
        "properties": {
          "deleted": {
            "title": "Deleted",
            "type": "integer"
          },
          "events": {
            "title": "Events",
            "type": "integer"
          },
          "items": {
            "title": "Items",
            "type": "integer"
          },
          "last_event_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Event At"
          },
          "source": {
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "source",
          "items",
          "deleted",
          "events",
          "last_event_at"
        ],
        "title": "SourceView",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Local, read-only view of the knowledge base (D19).",
    "title": "ekb inspector",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/documents": {
      "get": {
        "operationId": "documents_api_documents_get",
        "parameters": [
          {
            "in": "query",
            "name": "source",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Source"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DocumentView"
                  },
                  "title": "Response Documents Api Documents Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Documents"
      }
    },
    "/api/events": {
      "get": {
        "operationId": "events_api_events_get",
        "parameters": [
          {
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Since",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "source",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Source"
            }
          },
          {
            "in": "query",
            "name": "document_key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Document Key"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Events"
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Api Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/sources": {
      "get": {
        "operationId": "sources_api_sources_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SourceView"
                  },
                  "title": "Response Sources Api Sources Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Sources"
      }
    }
  }
}
