{
  "name": "ekb-inspector-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local, read-only inspector for the enterprise knowledge base (D19).",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "node --experimental-strip-types --test tests/poll.test.mjs tests/originals.test.mjs",
    "lint": "eslint .",
    "gen:types": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8"
  }
}
